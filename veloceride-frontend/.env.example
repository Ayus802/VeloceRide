# Backend origin (no trailing slash). REST calls go to ${VITE_API_BASE_URL}/api/...
VITE_API_BASE_URL=http://localhost:8080
# STOMP WebSocket endpoint. Defaults to the API origin with ws(s):// and /ws when omitted.
VITE_WS_URL=ws://localhost:8080/ws
# Time zone the backend uses for ride dates/times (APP_TIME_ZONE on the server).
VITE_PLATFORM_TIME_ZONE=Asia/Kolkata
# Google Identity Services OAuth client id (same value as GOOGLE_CLIENT_ID on the backend).
# Leave empty to hide "Continue with Google".
VITE_GOOGLE_CLIENT_ID=1086967881630-jmltsveeq324f40dortln8s8nsel2km1.apps.googleusercontent.com

