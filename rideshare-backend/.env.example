# Copy to .env and fill in real values. Never commit .env.

# --- Spring profile: dev (local defaults) or prod (everything required) ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_PORT=8080

# --- Database ---
POSTGRES_DB=car-pool
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# --- JWT --- (at least 32 bytes; generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes
JWT_ACCESS_EXPIRATION=PT15M
JWT_REFRESH_EXPIRATION=P7D

# --- Frontend origin(s) allowed by CORS and the WebSocket handshake (comma separated, no wildcards) ---
FRONTEND_URL=http://localhost:5173

# --- Initial admin (created on first start only if the email does not exist yet) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Ch@ngeMe-Str0ng!

# --- Optional ---
APP_TIME_ZONE=Asia/Kolkata
VEHICLE_VERIFICATION_REQUIRED=true
LOCATION_MIN_UPDATE_INTERVAL=PT2S
LOCATION_HISTORY_ENABLED=true
SWAGGER_ENABLED=true

# --- Account verification (6-digit codes by email and SMS) ---
# Registration needs BOTH channels deliverable, otherwise /api/auth/register answers 503.
# Email over SMTP (e.g. Gmail app password, SendGrid, Mailgun, Amazon SES):
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_FROM=VeloceRide <no-reply@example.com>
# SMS via Twilio (Account SID, Auth Token, and a Twilio phone number in E.164 format).
# For WhatsApp instead of SMS, prefix the sender with "whatsapp:" — e.g. the sandbox number
# TWILIO_FROM_NUMBER=whatsapp:+14155238886 (recipients are prefixed automatically).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# DEV ONLY: print codes to the server log for channels without a provider. Never enable in production.
OTP_LOG_CODES=false

# --- Google sign-in ---
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console > APIs & Services > Credentials.
# Add your frontend origin (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# Use the same value as VITE_GOOGLE_CLIENT_ID in the frontend. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID= 1086967881630-jmltsveeq324f40dortln8s8nsel2km1.apps.googleusercontent.com
